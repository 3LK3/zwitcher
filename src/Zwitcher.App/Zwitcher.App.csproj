<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <UseWPF>true</UseWPF>
        <!-- WinForms is referenced only for NotifyIcon (WPF has no tray icon). -->
        <UseWindowsForms>true</UseWindowsForms>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <!-- WFO0003 prefers Application.SetHighDpiMode, which is for WinForms apps. This is a
             WPF app, so the manifest sets DPI awareness. -->
        <NoWarn>$(NoWarn);WFO0003</NoWarn>
        <ApplicationIcon>Assets\zwitcher.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <!-- Avoid WPF/WinForms type ambiguity (Application, MessageBox, ...) from implicit usings. -->
        <Using Remove="System.Windows.Forms" />
        <Using Remove="System.Drawing" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="Assets\zwitcher.ico" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Zwitcher.Core\Zwitcher.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Assets\zwitcher.ico" LogicalName="Zwitcher.App.Assets.zwitcher.ico" />
    </ItemGroup>
</Project>
