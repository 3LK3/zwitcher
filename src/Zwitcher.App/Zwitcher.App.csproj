<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <UseWPF>true</UseWPF>
        <!-- WinForms is referenced only for NotifyIcon (WPF has no tray icon). -->
        <UseWindowsForms>true</UseWindowsForms>
        <!-- uiAccess builds only start when signed and installed under Program Files, so they
             are opt-in: build/publish.ps1 passes -p:UiAccess=true only when it signs. -->
        <UiAccess Condition="'$(UiAccess)' == ''">false</UiAccess>
        <ApplicationManifest Condition="'$(UiAccess)' == 'true'">app.uiaccess.manifest</ApplicationManifest>
        <ApplicationManifest Condition="'$(UiAccess)' != 'true'">app.manifest</ApplicationManifest>
        <!-- WFO0003 prefers Application.SetHighDpiMode, which is for WinForms apps. This is a
             WPF app, so the manifest sets DPI awareness. -->
        <NoWarn>$(NoWarn);WFO0003</NoWarn>
        <ApplicationIcon>Assets\zwitcher.ico</ApplicationIcon>
        <!-- The exe name and file description are what Task Manager and Startup apps show. -->
        <!-- Not Zwitcher.exe: that name belongs to Zwitcher.Launcher, Velopack's main exe. -->
        <AssemblyName>Zwitcher.App</AssemblyName>
        <AssemblyTitle>Zwitcher</AssemblyTitle>
        <Product>Zwitcher</Product>
    </PropertyGroup>

    <ItemGroup>
        <!-- Avoid WPF/WinForms type ambiguity (Application, MessageBox, ...) from implicit usings. -->
        <Using Remove="System.Windows.Forms" />
        <Using Remove="System.Drawing" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="Assets\zwitcher.ico" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Zwitcher.Core\Zwitcher.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <ApplicationDefinition Remove="App.xaml" />
        <Page Include="App.xaml" />
    </ItemGroup>

    <PropertyGroup>
        <StartupObject>Zwitcher.App.App</StartupObject>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/3LK3/zwitcher</RepositoryUrl>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="Assets\zwitcher.ico" LogicalName="Zwitcher.App.Assets.zwitcher.ico" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\LICENSE">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
        <None Include="..\..\README.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Velopack" Version="1.2.161" />
    </ItemGroup>
</Project>
