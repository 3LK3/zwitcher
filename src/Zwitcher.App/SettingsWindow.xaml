<Window
    x:Class="Zwitcher.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Zwitcher Settings"
    ResizeMode="NoResize"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterScreen"
>
    <StackPanel Width="280" Margin="16">
        <CheckBox
            x:Name="EnabledBox"
            Margin="0,0,0,8"
            Click="OnEnabledClicked"
            Content="Replace Alt+Tab"
        />
        <CheckBox
            x:Name="StartupBox"
            Margin="0,0,0,16"
            Click="OnStartupClicked"
            Content="Start with Windows"
        />
        <TextBlock Margin="0,0,0,4" Text="Show on" />
        <ComboBox
            x:Name="ShowOnBox"
            Margin="0,0,0,12"
            DisplayMemberPath="Label"
            SelectedValuePath="Value"
            SelectionChanged="OnShowOnChanged"
        />
        <TextBlock Margin="0,0,0,4" Text="Layout" />
        <ComboBox
            x:Name="LayoutBox"
            DisplayMemberPath="Label"
            SelectedValuePath="Value"
            SelectionChanged="OnLayoutChanged"
        />
    </StackPanel>
</Window>
