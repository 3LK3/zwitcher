<Window
    x:Class="Zwitcher.App.Overlay.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    Title="Zwitcher"
    Width="480"
    Height="200"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    Topmost="True"
    ShowInTaskbar="False"
    ShowActivated="False"
    WindowStartupLocation="Manual"
>
    <Window.Resources>
        <!-- One set per OverlayLayout value: {name}Width, {name}Panel and {name}Item. -->
        <sys:Double x:Key="ListWidth">480</sys:Double>
        <ItemsPanelTemplate x:Key="ListPanel">
            <StackPanel />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="ListItem">
            <Border
                x:Name="Row"
                Padding="8,5"
                Background="Transparent"
                CornerRadius="5"
                MouseLeftButtonUp="OnRowClicked"
            >
                <DockPanel>
                    <Image
                        Width="24"
                        Height="24"
                        Margin="0,0,10,0"
                        DockPanel.Dock="Left"
                        Source="{Binding Icon}"
                    />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="#FFF2F2F2"
                        Text="{Binding Title}"
                        TextTrimming="CharacterEllipsis"
                    />
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="#FF2F6FDE" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <sys:Double x:Key="GridWidth">560</sys:Double>
        <ItemsPanelTemplate x:Key="GridPanel">
            <WrapPanel />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="GridItem">
            <Border
                x:Name="Tile"
                Width="104"
                Height="96"
                Margin="2"
                Padding="6"
                Background="Transparent"
                CornerRadius="6"
                MouseLeftButtonUp="OnRowClicked"
            >
                <DockPanel>
                    <Image
                        Width="40"
                        Height="40"
                        Margin="0,2,0,6"
                        DockPanel.Dock="Top"
                        Source="{Binding Icon}"
                    />
                    <TextBlock
                        FontSize="12"
                        Foreground="#FFF2F2F2"
                        Text="{Binding Title}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                    />
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Tile" Property="Background" Value="#FF2F6FDE" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border
        x:Name="Panel"
        Padding="6"
        Background="#FF202020"
        BorderBrush="#40FFFFFF"
        BorderThickness="1"
        CornerRadius="8"
    >
        <ScrollViewer x:Name="Scroller" Focusable="False" VerticalScrollBarVisibility="Hidden">
            <ItemsControl x:Name="Rows" Focusable="False" />
        </ScrollViewer>
    </Border>
</Window>
