<Window
    x:Class="Zwitcher.App.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Zwitcher"
    Width="480"
    Height="200"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    Topmost="True"
    ShowInTaskbar="False"
    ShowActivated="False"
    WindowStartupLocation="Manual"
>
    <Border
        x:Name="Panel"
        Padding="6"
        Background="#FF202020"
        BorderBrush="#40FFFFFF"
        BorderThickness="1"
        CornerRadius="8"
    >
        <ItemsControl x:Name="Rows" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border
                        x:Name="Row"
                        Padding="8,5"
                        Background="Transparent"
                        CornerRadius="5"
                        MouseLeftButtonUp="OnRowClicked"
                    >
                        <DockPanel>
                            <Image
                                Width="24"
                                Height="24"
                                Margin="0,0,10,0"
                                DockPanel.Dock="Left"
                                Source="{Binding Icon}"
                            />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="#FFF2F2F2"
                                Text="{Binding Title}"
                                TextTrimming="CharacterEllipsis"
                            />
                        </DockPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="#FF2F6FDE" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</Window>
