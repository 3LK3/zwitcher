<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- CsWin32's generated signatures use pointers. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
        <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.369">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <!-- CsWin32 only auto-includes NativeMethods.txt from the project root. -->
        <AdditionalFiles Include="Interop\NativeMethods.txt" />
    </ItemGroup>
</Project>
